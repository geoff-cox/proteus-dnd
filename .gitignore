# Root ignore rules

# Byte-compiled / packaging
__pycache__/
*.py[cod]
/build/
dist/
*.egg-info/
.pytest_cache/

# Environments
.venv
.env

# The working database, wherever a command creates it
*.db

# Files named with *LOCAL-ONLY* are not committed
*LOCAL-ONLY*

# The preview debug build's scratch directory
/preview_build_debug/

# No student data may enter this repository so as a precaution all
# CSVs are ignored. The safe CSVs are excluded from the rule based on
# location.
*.csv
!src/tests/fixtures/*.csv
!src/proteus/services/dragndrop/aliases/*.csv
!src/proteus/services/dragndrop/logging_regimes/*.csv
!paper1/paper1-board-identity-witness-2026-10-07.csv
!paper1/audit-training-kit/**/*.csv

# dev files
OPEN-TODOS.md 
CLAUDE.md
